    <classstyles>
        <classstyle name=".container-site" key=".container-site" class="mx-auto w-full max-w-[86rem] px-5 md:px-10" component></classstyle>
        <classstyle name=".section" key=".section" class="border-t border-ink bg-page py-20 md:py-28" component></classstyle>
        <classstyle name=".section-hero" key=".section-hero" class="bg-page pt-10 pb-16 md:pt-14 md:pb-24" component></classstyle>
        <classstyle name=".grid-paper" key=".grid-paper" class="bg-[linear-gradient(to_right,color-mix(in_oklab,var(--color-line)_55%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklab,var(--color-line)_55%,transparent)_1px,transparent_1px)] bg-[size:2rem_2rem]" component></classstyle>
        <classstyle name=".section-head" key=".section-head" class="mb-12 grid items-end gap-6 border-b border-line pb-10 md:grid-cols-12 md:[&>.lead]:col-span-5 md:[&>.sheet-label]:col-span-12 md:[&>h2]:col-span-7" component></classstyle>
        <classstyle name=".sheet-label" key=".sheet-label" class="inline-flex w-fit items-center self-start border border-ink px-2 py-1 font-mono text-[11px] tracking-wider text-ink uppercase" component></classstyle>
        <classstyle name=".ref" key=".ref" class="font-mono text-xs tracking-wider text-muted uppercase" component></classstyle>
        <classstyle name=".caption" key=".caption" class="font-mono text-xs text-muted" component></classstyle>
        <classstyle name=".site-header" key=".site-header" class="sticky top-0 z-40 border-b border-ink bg-page text-ink" component></classstyle>
        <classstyle name=".brand" key=".brand" class="inline-flex items-center gap-3 font-display text-lg font-semibold tracking-tight text-ink" component></classstyle>
        <classstyle name=".brand-mark" key=".brand-mark" class="grid h-8 w-8 place-items-center bg-primary font-mono text-[11px] font-semibold text-on-primary" component></classstyle>
        <classstyle name=".nav-link" key=".nav-link" class="font-mono text-xs tracking-wider text-muted uppercase transition hover:text-ink" component></classstyle>
        <classstyle name=".skip-link" key=".skip-link" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary" component></classstyle>
        <classstyle name=".mobile-menu" key=".mobile-menu" class="relative" component></classstyle>
        <classstyle name=".mobile-menu-button" key=".mobile-menu-button" class="cursor-pointer list-none border border-ink px-3 py-2 font-mono text-xs tracking-wider uppercase [&::-webkit-details-marker]:hidden" component></classstyle>
        <classstyle name=".mobile-menu-panel" key=".mobile-menu-panel" class="fixed inset-x-0 top-16 flex flex-col gap-5 border-b border-ink bg-page px-5 pt-6 pb-10" component></classstyle>
        <classstyle name=".btn-primary" key=".btn-primary" class="inline-flex items-center justify-center gap-2 border border-primary bg-primary px-5 py-3 text-sm font-semibold text-on-primary transition hover:border-ink hover:bg-ink hover:text-page focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" component></classstyle>
        <classstyle name=".btn-secondary" key=".btn-secondary" class="inline-flex items-center justify-center gap-2 border border-ink px-5 py-3 text-sm font-semibold text-ink transition hover:bg-ink hover:text-page focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" component></classstyle>
        <classstyle name=".btn-on-band" key=".btn-on-band" class="inline-flex items-center justify-center border border-on-band bg-on-band px-5 py-3 text-sm font-semibold text-band transition hover:bg-transparent hover:text-on-band" component></classstyle>
        <classstyle name=".heading-display" key=".heading-display" class="font-display text-[clamp(2.75rem,6vw,5.75rem)] leading-[0.95] font-semibold tracking-[-0.045em] text-balance text-ink" component></classstyle>
        <classstyle name=".heading-xl" key=".heading-xl" class="font-display text-[clamp(2.5rem,5vw,4.75rem)] leading-[0.98] font-semibold tracking-[-0.04em] text-balance text-ink" component></classstyle>
        <classstyle name=".heading-lg" key=".heading-lg" class="font-display text-[clamp(2rem,3.6vw,3.25rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-ink" component></classstyle>
        <classstyle name=".heading-md" key=".heading-md" class="font-display text-xl leading-snug font-semibold tracking-tight text-ink" component></classstyle>
        <classstyle name=".lead" key=".lead" class="text-lg leading-relaxed text-muted" component></classstyle>
